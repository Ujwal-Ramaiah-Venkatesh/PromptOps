{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PromptOps Sub-Task Schema",
  "description": "Schema for decomposed DevOps sub-tasks generated from high-level PM commands",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "decomposition_id",
    "timestamp",
    "original_intent",
    "total_sub_tasks",
    "estimated_duration",
    "execution_strategy",
    "sub_tasks"
  ],
  "properties": {
    "decomposition_id": {
      "type": "string",
      "pattern": "^decomp-\\d{4}-\\d{2}-\\d{2}-[a-f0-9]{6}$",
      "description": "Unique identifier for this decomposition (format: decomp-YYYY-MM-DD-XXXXXX)",
      "examples": ["decomp-2026-05-05-a1b2c3"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when decomposition was created"
    },
    "original_intent": {
      "type": "object",
      "description": "Original parsed PM command from Week 3-4 parser",
      "required": ["intent_type", "command_id"],
      "properties": {
        "command_id": { "type": "string" },
        "intent_type": {
          "type": "string",
          "enum": ["deploy", "scale", "rollback", "monitor", "audit", "cost", "security", "diagnose"]
        },
        "target_service": { "type": ["string", "null"] },
        "target_env": { "type": ["string", "null"] },
        "parameters": { "type": "object" },
        "confidence_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "risk_level": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        }
      }
    },
    "total_sub_tasks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "description": "Total number of sub-tasks generated"
    },
    "estimated_duration": {
      "type": "string",
      "pattern": "^\\d+-\\d+ (seconds|minutes|hours)$",
      "description": "Estimated total execution time",
      "examples": ["5-7 minutes", "30-45 seconds", "2-3 hours"]
    },
    "execution_strategy": {
      "type": "string",
      "enum": ["sequential", "parallel", "sequential_with_parallel_phases", "conditional"],
      "description": "Overall execution strategy"
    },
    "sub_tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "description": "Array of atomic sub-tasks",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "sequence",
          "phase",
          "action",
          "target",
          "parameters",
          "dependencies",
          "can_run_parallel",
          "estimated_duration",
          "rollback_action",
          "validation_criteria",
          "risk_level"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^task-\\d{3}$",
            "description": "Unique task identifier within this decomposition",
            "examples": ["task-001", "task-042"]
          },
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "description": "Execution order (1-based)"
          },
          "phase": {
            "type": "string",
            "enum": [
              "pre_validation",
              "pre_deployment",
              "deployment",
              "post_deployment",
              "validation",
              "monitoring",
              "cleanup",
              "rollback",
              "approval_gate",
              "conditional_gate"
            ],
            "description": "Logical phase grouping"
          },
          "action": {
            "type": "string",
            "description": "Action to perform (verb + noun format)",
            "examples": [
              "validate_version_exists",
              "deploy_canary",
              "run_health_check",
              "scale_instances",
              "update_load_balancer",
              "create_backup",
              "rotate_secret",
              "provision_database"
            ]
          },
          "target": {
            "type": "string",
            "description": "Resource being acted upon",
            "examples": [
              "api",
              "database",
              "load_balancer",
              "docker_registry",
              "aws_ec2",
              "kubernetes_deployment"
            ]
          },
          "parameters": {
            "type": "object",
            "description": "Action-specific parameters (flexible schema)",
            "examples": [
              { "version": "v2.1.0", "replicas": 5 },
              { "instance_type": "t3.medium", "count": 10 },
              { "backup_retention_days": 30 }
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^task-\\d{3}$"
            },
            "description": "List of task_ids that must complete before this task",
            "examples": [["task-001", "task-002"], []]
          },
          "can_run_parallel": {
            "type": "boolean",
            "description": "True if this task can run concurrently with other tasks in same phase"
          },
          "estimated_duration": {
            "type": "string",
            "pattern": "^\\d+ (seconds|minutes|hours)$",
            "description": "Estimated time for this task",
            "examples": ["30 seconds", "5 minutes", "2 hours"]
          },
          "rollback_action": {
            "type": ["string", "null"],
            "description": "How to undo this task (null if irreversible)",
            "examples": [
              "revert_to_previous_version",
              "restore_from_backup",
              "delete_created_resources",
              null
            ]
          },
          "rollback_note": {
            "type": "string",
            "description": "Additional rollback context (required if rollback_action is null)"
          },
          "validation_criteria": {
            "type": "object",
            "required": ["expected_status", "timeout"],
            "properties": {
              "expected_status": {
                "type": "string",
                "description": "What constitutes success",
                "examples": [
                  "http_200",
                  "all_instances_healthy",
                  "zero_errors_in_logs",
                  "database_migrated"
                ]
              },
              "timeout": {
                "type": "integer",
                "minimum": 1,
                "description": "Max seconds to wait for success"
              },
              "retry_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5,
                "description": "Number of retry attempts (default: 0)"
              },
              "retry_delay": {
                "type": "integer",
                "minimum": 1,
                "description": "Seconds between retries (default: 5)"
              }
            }
          },
          "risk_level": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"],
            "description": "Risk level for this specific sub-task"
          },
          "approval_required": {
            "type": "boolean",
            "description": "Whether human approval is required before executing this task"
          },
          "approval_timeout": {
            "type": "integer",
            "description": "Seconds to wait for approval (default: 3600 = 1 hour)"
          },
          "scheduled_time": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "ISO 8601 timestamp for scheduled execution (null = execute immediately)"
          },
          "conditional": {
            "type": ["object", "null"],
            "description": "Conditional execution logic (null = always execute)",
            "properties": {
              "condition": {
                "type": "string",
                "description": "Condition to evaluate",
                "examples": [
                  "tests_passed",
                  "error_rate < 1%",
                  "cpu_usage < 80%",
                  "previous_task_success"
                ]
              },
              "if_true": {
                "type": "string",
                "enum": ["continue", "skip", "abort"],
                "description": "Action if condition is true"
              },
              "if_false": {
                "type": "string",
                "enum": ["continue", "skip", "abort", "rollback"],
                "description": "Action if condition is false"
              }
            },
            "required": ["condition", "if_true", "if_false"]
          },
          "idempotent": {
            "type": "boolean",
            "description": "Whether this task can be safely re-run multiple times"
          },
          "resource_locks": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Resources that must be locked during execution",
            "examples": [["database", "api_deployment"]]
          },
          "cost_estimate": {
            "type": ["object", "null"],
            "properties": {
              "amount": { "type": "number", "minimum": 0 },
              "currency": { "type": "string", "default": "USD" },
              "recurring": { "type": "boolean", "description": "One-time or recurring cost" }
            }
          },
          "agent_type": {
            "type": "string",
            "description": "Which execution agent handles this task (for Phase 2)",
            "examples": [
              "deploy_agent",
              "scale_agent",
              "database_agent",
              "monitoring_agent"
            ]
          }
        }
      }
    },
    "execution_plan": {
      "type": "object",
      "description": "Grouped execution phases for parallelization",
      "properties": {
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["phase_number", "phase_name", "task_ids", "execution_mode"],
            "properties": {
              "phase_number": { "type": "integer", "minimum": 1 },
              "phase_name": { "type": "string" },
              "task_ids": {
                "type": "array",
                "items": { "type": "string", "pattern": "^task-\\d{3}$" }
              },
              "execution_mode": {
                "type": "string",
                "enum": ["parallel", "sequential"]
              },
              "estimated_duration": { "type": "string" }
            }
          }
        },
        "critical_path": {
          "type": "array",
          "items": { "type": "string", "pattern": "^task-\\d{3}$" },
          "description": "Longest sequential chain (determines minimum execution time)"
        },
        "total_sequential_time": {
          "type": "string",
          "description": "Time if all tasks run sequentially"
        },
        "total_parallel_time": {
          "type": "string",
          "description": "Time with optimal parallelization"
        }
      }
    },
    "rollback_plan": {
      "type": "object",
      "required": ["rollback_sequence", "estimated_rollback_duration"],
      "properties": {
        "rollback_sequence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["step", "task_id", "rollback_action"],
            "properties": {
              "step": { "type": "integer", "minimum": 1 },
              "task_id": { "type": "string", "pattern": "^task-\\d{3}$" },
              "rollback_action": { "type": ["string", "null"] },
              "rollback_note": { "type": "string" }
            }
          },
          "description": "Tasks to rollback in reverse execution order"
        },
        "estimated_rollback_duration": {
          "type": "string",
          "pattern": "^\\d+-\\d+ (seconds|minutes|hours)$"
        },
        "irreversible_tasks": {
          "type": "array",
          "items": { "type": "string", "pattern": "^task-\\d{3}$" },
          "description": "Tasks that cannot be rolled back"
        }
      }
    },
    "risk_assessment": {
      "type": "object",
      "properties": {
        "overall_risk": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "risk_factors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "factor": { "type": "string" },
              "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
              "mitigation": { "type": "string" }
            }
          }
        },
        "requires_approval": {
          "type": "boolean",
          "description": "Whether any task requires human approval"
        },
        "blast_radius": {
          "type": "string",
          "enum": ["single_service", "multiple_services", "environment_wide", "multi_environment"],
          "description": "Scope of potential impact"
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "decomposition_model": {
          "type": "string",
          "description": "AI model used for decomposition",
          "examples": ["claude-sonnet-4-20250514"]
        },
        "decomposition_cost": {
          "type": "number",
          "description": "API cost for this decomposition (USD)"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "generated_by": {
          "type": "string",
          "description": "User or system that triggered decomposition"
        }
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "is_valid": { "type": "boolean" },
        "validation_errors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dependency_graph_valid": { "type": "boolean" },
        "circular_dependencies_detected": { "type": "boolean" },
        "orphan_tasks_detected": { "type": "boolean" }
      }
    }
  }
}
