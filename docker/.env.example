# PromptOps Production Environment Variables
# ===========================================
#
# Copy this file to .env and fill in your values
# NEVER commit .env to git (it contains secrets)
#
# Usage:
#   cp docker/.env.example docker/.env
#   nano docker/.env  # Edit values
#   docker-compose -f docker/docker-compose.prod.yml up -d
#
# Author: PromptOps Team
# Phase: 5A - Production Deployment

# ============================================================================
# Application Settings
# ============================================================================

# Environment (development, staging, production)
ENVIRONMENT=production

# Application version
APP_VERSION=5.0.0

# Debug mode (false for production)
DEBUG=false

# ============================================================================
# Database Configuration
# ============================================================================

POSTGRES_DB=promptops
POSTGRES_USER=promptops
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Full connection string (auto-generated if not set)
# DATABASE_URL=postgresql://promptops:PASSWORD@postgres:5432/promptops

# ============================================================================
# Security & Authentication
# ============================================================================

# JWT Secret Key (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=CHANGE_ME_GENERATE_STRONG_SECRET

# JWT Settings
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Session Secret (generate with: openssl rand -hex 32)
SESSION_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET

# ============================================================================
# CORS Configuration
# ============================================================================

# Allowed origins (comma-separated)
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ============================================================================
# Cloud Provider Credentials
# ============================================================================

# AWS Credentials (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# GCP Credentials (optional)
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_KEY_PATH=/app/secrets/gcp-key.json

# Azure Credentials (optional)
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ============================================================================
# ML Settings
# ============================================================================

# Enable ML features
ENABLE_ML_FEATURES=true

# ML model storage path
ML_MODEL_PATH=/app/models

# Anomaly detection sensitivity (low, medium, high)
ANOMALY_DETECTION_SENSITIVITY=medium

# ============================================================================
# Monitoring & Logging
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable Prometheus metrics
PROMETHEUS_ENABLED=true

# Grafana admin credentials
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ============================================================================
# Email Notifications (Optional - SendGrid Free Tier)
# ============================================================================

# Email provider (sendgrid, smtp, none)
EMAIL_PROVIDER=none

# SendGrid API Key (if using SendGrid)
SENDGRID_API_KEY=

# SMTP Settings (if using SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourdomain.com

# ============================================================================
# Rate Limiting
# ============================================================================

# Requests per minute per IP
RATE_LIMIT_PER_MINUTE=100

# Burst allowance
RATE_LIMIT_BURST=20

# ============================================================================
# Backup Configuration
# ============================================================================

# Backup retention (days)
BACKUP_RETENTION_DAYS=30

# Backup schedule (cron format: daily at 2 AM)
BACKUP_SCHEDULE=0 2 * * *

# ============================================================================
# External Services (Optional)
# ============================================================================

# Slack webhook URL for alerts (optional)
SLACK_WEBHOOK_URL=

# PagerDuty integration key (optional)
PAGERDUTY_INTEGRATION_KEY=

# ============================================================================
# Frontend Configuration
# ============================================================================

# API URL (backend endpoint)
REACT_APP_API_URL=http://localhost:8000

# Frontend URL
REACT_APP_FRONTEND_URL=http://localhost:3003

# ============================================================================
# Feature Flags
# ============================================================================

# Enable multi-tenancy
ENABLE_MULTI_TENANCY=false

# Enable SSO
ENABLE_SSO=false

# Enable audit logging
ENABLE_AUDIT_LOG=true

# Enable auto-remediation
ENABLE_AUTO_REMEDIATION=false

# ============================================================================
# Resource Limits
# ============================================================================

# Maximum concurrent scans
MAX_CONCURRENT_SCANS=5

# Scan timeout (seconds)
SCAN_TIMEOUT_SECONDS=300

# API request timeout (seconds)
API_TIMEOUT_SECONDS=30

# ============================================================================
# Database Connection Pool
# ============================================================================

# Minimum pool size
DB_POOL_MIN_SIZE=5

# Maximum pool size
DB_POOL_MAX_SIZE=20

# Connection timeout (seconds)
DB_POOL_TIMEOUT=30

# ============================================================================
# Notes
# ============================================================================

# Security Checklist:
# [ ] Changed all CHANGE_ME passwords
# [ ] Generated strong JWT_SECRET_KEY
# [ ] Generated strong SESSION_SECRET
# [ ] Set production CORS_ORIGINS
# [ ] Configured cloud provider credentials (if needed)
# [ ] Set Grafana admin password
# [ ] Configured backup settings
# [ ] Set proper LOG_LEVEL (INFO or WARNING for prod)
# [ ] Reviewed and set feature flags
# [ ] Tested database connection
# [ ] Verified all services start successfully

# Deployment Checklist:
# [ ] Copied .env.example to .env
# [ ] Filled in all required values
# [ ] Verified .env is in .gitignore
# [ ] Tested with docker-compose up
# [ ] Configured SSL certificates (if using HTTPS)
# [ ] Set up backup automation
# [ ] Configured monitoring alerts
# [ ] Tested health checks
# [ ] Performed security scan
# [ ] Reviewed logs for errors
