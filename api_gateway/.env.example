# Example Environment Configuration
# Copy this file to .env.development and fill in your values

# CORS - Allowed Origins (comma-separated, no spaces)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-here-minimum-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/promptops

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# AWS Configuration (optional for local development)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Claude API (optional for local development)
# CLAUDE_API_KEY=

# Rate Limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=100

# Logging
LOG_LEVEL=INFO
