# Production Environment Configuration
# Week 13-15: Security Configuration

# CORS - Allowed Origins (production frontend URLs ONLY)
CORS_ORIGINS=https://dashboard.promptops.com,https://promptops.com,https://www.promptops.com

# JWT Configuration - MUST USE AWS SECRETS MANAGER
# JWT_SECRET_KEY will be loaded from AWS Secrets Manager in production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database - Connection string from AWS Secrets Manager
# DATABASE_URL will be loaded from AWS Secrets Manager in production

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# AWS Configuration
AWS_REGION=us-east-1

# Claude API - Stored in AWS Secrets Manager
# CLAUDE_API_KEY will be loaded from AWS Secrets Manager

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=WARNING

# Security
FORCE_HTTPS=true
HSTS_MAX_AGE=31536000
