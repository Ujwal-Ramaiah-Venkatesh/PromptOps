# Staging Environment Configuration
# Week 13-15: Security Configuration

# CORS - Allowed Origins (staging frontend URLs)
CORS_ORIGINS=https://staging-dashboard.promptops.com,https://staging.promptops.com

# JWT Configuration - MUST BE CHANGED IN PRODUCTION
JWT_SECRET_KEY=staging-secret-key-replace-with-aws-secrets-manager
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=postgresql://promptops_user:REPLACE_PASSWORD@promptops-staging.cluster-xxxxx.us-east-1.rds.amazonaws.com:5432/promptops

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# AWS Configuration
AWS_REGION=us-east-1

# Claude API
# CLAUDE_API_KEY stored in AWS Secrets Manager

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Logging
LOG_LEVEL=INFO
